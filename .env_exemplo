BASE_DIR = '/'
URL_ADMIN = ''
SENTRY_DSN = ''

; Diretório de logs — deve ficar FORA do DocumentRoot (public/)
; Relativo ao CWD do Apache (public/), '../logs/' aponta para a raiz do projeto
LOG_DIR = '../logs/'
; Habilita log de SQLs executados com sucesso (desabilite em produção)
LOG_SQL = false

TOKEN_JV[] = ''

ERROR_CONTROLLER = 'ErrorController'
DEFAULT_ACTION = 'index'

FOCCO_DRIVER = ''
FOCCO_HOST = ''
FOCCO_PORT = ''
FOCCO_DATABASE = ''
FOCCO_USER = ''
FOCCO_PASS = ''