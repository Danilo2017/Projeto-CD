# Bloqueia arquivos temporários de manutenção/patch
<FilesMatch "^(patch-|exec).*\.php$">
    Order Allow,Deny
    Deny from all
</FilesMatch>

# Bloqueia CSVs de dados temporários
<FilesMatch "\.csv$">
    Order Allow,Deny
    Deny from all
</FilesMatch>

RewriteEngine On
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-l
RewriteRule ^(.*)$ index.php?request=$1 [QSA,L]